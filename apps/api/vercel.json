{
  "functions": {
    "apps/api/api/index.ts": {
      "runtime": "@vercel/node@5.3.24"
    }
  },

  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/health/db",
      "schedule": "0 12 * * 1,4"
    }
  ],
  "buildCommand": "pnpm build"
}
